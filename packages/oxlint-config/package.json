{
  "name": "@zachsents/oxlint-config",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^6.0.3",
    "zshy": "^0.7.3"
  },
  "peerDependencies": {
    "eslint": ">=9.22.0",
    "oxlint": ">=1.74.0"
  },
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "bun": "./react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./eslint": {
      "bun": "./eslint.ts",
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    }
  },
  "description": "Zach's shared Oxlint and ESLint configuration.",
  "files": [
    "dist",
    "index.ts",
    "react.ts",
    "eslint.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware\" \"bun --bun eslint .\"",
    "lint:fix": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware --fix-suggestions\" \"bun --bun eslint . --fix\"",
    "build": "zshy",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "zshy": {
    "exports": {
      ".": "./index.ts",
      "./react": "./react.ts",
      "./eslint": "./eslint.ts"
    },
    "cjs": false,
    "conditions": {
      "bun": "src"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachsents/zachs-tools.git",
    "directory": "packages/oxlint-config"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-zachs-rules": "workspace:*"
  }
}
