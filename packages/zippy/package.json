{
  "name": "@zachsents/zippy",
  "version": "1.4.0",
  "description": "A TypeScript utility library.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zachsents/zachs-tools.git",
    "directory": "packages/zippy"
  },
  "publishConfig": {
    "access": "public"
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts"
    },
    "cjs": false,
    "conditions": {
      "bun": "src"
    }
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware\" \"bun --bun eslint .\"",
    "lint:fix": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware --fix-suggestions\" \"bun --bun eslint . --fix\"",
    "check:fn": "./scripts/check-function.sh",
    "typecheck:file": "./scripts/typecheck-file.sh",
    "test": "bun test --concurrent",
    "build": "zshy",
    "pack:dry": "bun pm pack --dry-run",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check && bun run build && bun run pack:dry"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/lib/autocomplete-test-utils.ts",
    "!src/**/*.test.ts",
    "!src/**/*.type-test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@zachsents/oxlint-config": "workspace:*",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "remeda": "^2.39.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "zshy": "^0.7.2"
  }
}
