{
  "name": "@zachsents/ts-mcp",
  "version": "0.3.7",
  "description": "Give AI agents TypeScript type awareness",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ts-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "typescript",
    "native",
    "type-inference",
    "lsp",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zachsents/zachs-tools.git",
    "directory": "packages/ts-mcp"
  },
  "author": "Zach Sents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.build.json && shx chmod +x dist/index.js",
    "lint": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware\" \"bun --bun eslint .\"",
    "lint:fix": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware --fix --fix-suggestions\" \"bun --bun eslint . --fix\"",
    "test": "bun test/smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@zachsents/oxlint-config": "workspace:*",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "shx": "^0.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "typescript": "^7.0.2",
    "zod": "^4.3.6"
  }
}
