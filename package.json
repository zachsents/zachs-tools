{
  "name": "zachs-tools",
  "private": true,
  "packageManager": "bun@1.3.12",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "agent-rules:sync": "bun plugins/zach-codex/scripts/sync-agent-rules.ts",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "turbo run check check:root && bun run build",
    "check:root": "bun run format:check && bun run lint:root && bun run typecheck:scripts",
    "ci:version": "bun run version",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "bun run typecheck && bun run lint:fix && bun run format",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "lint:root": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware scripts\" \"bun --bun eslint scripts\"",
    "lint:root:fix": "concurrently --success all --kill-others-on-fail \"oxlint --type-aware scripts --fix --fix-suggestions\" \"bun --bun eslint scripts --fix\"",
    "plugin:sync-version": "bun scripts/sync-plugin-version.ts",
    "test": "turbo run test",
    "typecheck": "bun run typecheck:scripts && turbo run typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "version": "changeset version && bun run plugin:sync-version && bun update"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@zachsents/oxlint-config": "workspace:*",
    "@zachsents/prettier-config": "workspace:*",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.4.2",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  }
}
